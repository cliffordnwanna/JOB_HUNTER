# OpenAI configuration for CV skill extraction (required for accurate parsing)
# Without this, the parser falls back to a lower-quality regex extractor.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI configuration for Semantic Matching (Optional)
# This demonstrates RAG patterns for the Azure AI Developer portfolio.
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
